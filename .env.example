# Copia a .env y rellena (ver SUPABASE_SETUP.md). Nunca commitear .env real.
# Frontend (Vite, build-time)
VITE_SUPABASE_URL=https://xyzcompany.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR
VITE_SUPABASE_PROJECT_ID=xyzcompany

# Backend / SSR (server-only, nunca exponer al navegador)
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REEMPLAZAR
SUPABASE_PROJECT_ID=xyzcompany

# Cifrado AES-GCM de API keys de exchanges (requerido por crypto.server.ts)
CREDENTIALS_ENCRYPTION_KEY=REEMPLAZAR_con_32_chars_aleatorios_minimo

# Órdenes REALES en Binance: por defecto se envían a TESTNET (dinero de prueba).
# Ponlo en "production" solo cuando el modo Real ya esté validado en testnet.
BINANCE_TRADING_ENV=testnet

# Cron nube (endpoints /api/public/automation-tick y /api/public/maintenance)
LOVABLE_CRON_SECRET=REEMPLAZAR_aleatorio_largo
LOVABLE_CRON_SECRET_PREVIOUS=

# Reportes email (opcional, requiere dominio verificado)
RESEND_API_KEY=
REPORTS_FROM_EMAIL=
